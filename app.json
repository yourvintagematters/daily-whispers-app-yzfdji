{
  "expo": {
    "name": "Daily Whispers",
    "slug": "daily-whispers",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F2F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dailywhispers.app",
      "buildNumber": "1.0.4",
      "associatedDomains": [
        "applinks:derryth.com.au"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Daily Whispers needs access to your photo library to save quotes as images.",
        "NSPhotoLibraryAddUsageDescription": "Daily Whispers needs permission to save quotes to your photo library.",
        "NSUserNotificationsUsageDescription": "Daily Whispers sends you an inspirational quote each day. Allow notifications to receive this gift from someone who cares about you.",
        "NSLocalNotificationUsageDescription": "Daily Whispers sends you an inspirational quote each day. Allow notifications to receive this gift from someone who cares about you."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E6F2F8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dailywhispers.app",
      "versionCode": 2,
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "derryth.com.au",
              "pathPrefix": "/recipient"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/b84729c0-4f36-41ea-9d92-e46ccc02a67c.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/b84729c0-4f36-41ea-9d92-e46ccc02a67c.png",
          "color": "#5d8aa8",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Daily Whispers to save quotes to your photo library.",
          "savePhotosPermission": "Allow Daily Whispers to save quotes to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.dailywhispers.app",
          "enableGooglePay": false
        }
      ]
    ],
    "scheme": "dailywhispers",
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false
    },
    "extra": {
  "supabaseUrl": "https://cyktcpdmlsfjyrnutmln.supabase.co",
  "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3ZXNrZHVmc2drem5laWJqbmhlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcyNDc3OTcsImV4cCI6MjEwMjgyMzc5N30.jZ9XdMMe62HVBf3Y7AI3L4XWNgJiMWP8S-ERMnpECUk",
  "stripePublishableKey": "pk_test_51SN0VCD17kmTdMDJe4HOvt0h9XSdRMqtui4g4jgbMgKd4mmAEvKuW4NGVUdwyRCbIatOj6X75fE6x98lmABoTstG00tg3PE9L4",
  "apiUrl": "https://cyktcpdmlsfjyrnutmln.supabase.co/functions/v1",
  "router": {},
  "eas": {}
},

    "notification": {
      "icon": "./assets/images/b84729c0-4f36-41ea-9d92-e46ccc02a67c.png",
      "color": "#5d8aa8",
      "androidMode": "default",
      "androidCollapsedTitle": "Daily Whispers"
    },
    "privacy": "public",
    "privacyPolicyUrl": "https://yourvintagematters.github.io/Derryth_Nash_Creative/privacy_policy_daily_whispers",
    "description": "Daily Whispers - A gift-based app where you can purchase and send daily inspirational quotes to loved ones. Choose from 8 themed quote collections and brighten someone's day, every day for a year."
  },
  "scheme": "Daily Whispers"
}
